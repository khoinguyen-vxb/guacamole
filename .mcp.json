{
  "mcpServers": {
    "freecad": {
      "command": "uv",
      "args": [
        "run",
        "--project",
        "examples/ehopper/freecad-mcp",
        "--locked",
        "--no-dev",
        "freecad-mcp"
      ],
      "env": {
        "FREECAD_MCP_TOKEN": "${FREECAD_MCP_TOKEN:-}"
      }
    }
  }
}
